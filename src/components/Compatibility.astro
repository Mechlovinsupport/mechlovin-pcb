---
const { compatibility = [] } = Astro.props;
---
<section class="section" id="compatibility">
  <h2>Compatibility notes</h2>
  <div class="head-cta" style="margin: 6px 0 18px;">
    <a class="btn btn-ghost btn-sm" href="/compatibility">
      Check what fits your keyboard
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
  {compatibility.length > 0 && (
    <div class="compat-notes">
      <div class="compat-groups">
        {compatibility.map((g) => (
          <div class="compat-note">
            <div class="compat-note-title">{g.title}</div>
            <div class="compat-note-body">{g.body}</div>
          </div>
        ))}
      </div>
    </div>
  )}
</section>
