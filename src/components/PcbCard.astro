---
import { TYPE_LABELS } from '../data/labels.js';
const { pcb } = Astro.props;
const meta = pcb.rev ? `Rev. ${pcb.rev}` : '';
const cardImg = (pcb.images && pcb.images[0]) || pcb.heroImage;
const typeLabel = TYPE_LABELS[pcb.type];
---
<a class="pcb-card" href={`/pcb/${pcb.slug}`}>
  <div class="pcb-card-image">
    {cardImg
      ? <img src={cardImg} alt={pcb.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
      : <div class="placeholder"><span class="mono">{pcb.name}</span></div>}
  </div>
  <div class="pcb-card-body">
    <div class="pcb-card-head">
      <span class="pcb-card-name">{pcb.name}</span>
      <span class="pcb-card-tags">
        {typeLabel && <span class={`pcb-card-type type-${pcb.type}`}>{typeLabel}</span>}
        {pcb.layout && <span class="pcb-card-layout">{pcb.layout}</span>}
      </span>
    </div>
    {meta && <div class="pcb-card-meta mono">{meta}</div>}
  </div>
</a>
