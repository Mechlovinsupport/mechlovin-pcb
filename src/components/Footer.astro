---
import { getEntry } from 'astro:content';
import { LAYOUTS } from '../data/labels.js';
const guideHref = '/guides/flashing-firmware-qmk-toolbox';

// Editable footer text (CMS → Site pages → Footer), with fallbacks.
const f = (await getEntry('site', 'footer'))?.data ?? {};
const tagline = f.tagline || 'Custom mechanical keyboard PCBs, designed in Hanoi and shipped worldwide since 2019.';
const linksTitle = f.linksTitle || 'Mechlovin';
const links = (f.links && f.links.length) ? f.links.filter((l) => l.label || l.url) : [
  { label: 'Main store', url: 'https://mechlovin.studio' },
  { label: 'GitHub', url: 'https://github.com/mechlovin' },
  { label: 'Discord', url: 'https://discord.gg/mechlovin' },
];
const copyright = f.copyright || '© 2026 Mechlovin Studio · Designed in Hanoi';
const bottomRight = f.bottomRight || 'v3.0 · support.mechlovin.studio';
---
<footer>
  <div class="col-brand">
    <div class="wordmark">
      <span>mechlovin</span>
      <span class="dot"></span>
      <span class="wordmark-sub">studio</span>
    </div>
    <p>{tagline}</p>
  </div>
  <div>
    <h5>Resources</h5>
    <ul>
      <li><a href="/pcbs">All PCBs</a></li>
      <li><a href="/compatibility">Compatibility check</a></li>
      <li><a href={guideHref}>Build guides</a></li>
    </ul>
  </div>
  <div>
    <h5>Layouts</h5>
    <ul>
      {LAYOUTS.map((l) => <li><a href={`/pcbs#${encodeURIComponent(l)}`}>{l}</a></li>)}
    </ul>
  </div>
  <div>
    <h5>{linksTitle}</h5>
    <ul>
      {links.map((l) => (
        <li><a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  </div>
</footer>
<div class="footer-bottom">
  <span>{copyright}</span>
  <span>{bottomRight}</span>
</div>
