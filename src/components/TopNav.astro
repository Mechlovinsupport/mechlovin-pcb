---
// Top navigation — appears on every page. `active` highlights the current section.
import { getEntry } from 'astro:content';
const { active } = Astro.props;
// Points to the guides listing (not a single article) — the section grows over time.
const guideHref = '/guides';
// Brand link uses the CMS logo (Site pages → Home page → Home page logo) when set,
// otherwise the text wordmark. Either way it links back to the homepage.
const logo = (await getEntry('site', 'home'))?.data?.logo || '';
---
<nav class="topnav">
  <div class="topnav-inner">
    <a href="/" class="wordmark" aria-label="Mechlovin Studio — home">
      {logo ? (
        <img class="nav-logo" src={logo} alt="Mechlovin Studio" />
      ) : (
        <Fragment>
          <span>mechlovin</span>
          <span class="dot"></span>
          <span class="wordmark-sub">studio · pcb</span>
        </Fragment>
      )}
    </a>
    <div class="topnav-links">
      <a href="/pcbs" class={active === 'pcbs' ? 'active' : ''}>PCBs</a>
      <a href="/compatibility" class={active === 'compatibility' ? 'active' : ''}>Compatibility check</a>
      <a href={guideHref} class={active === 'guide' ? 'active' : ''}>Build guides</a>
    </div>
    <div class="topnav-right">
      <div class="search">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input placeholder="Search PCBs, firmware…" />
        <span class="kbd">⌘K</span>
      </div>
    </div>
  </div>
</nav>
