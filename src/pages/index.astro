---
import Base from '../layouts/Base.astro';
import PcbCard from '../components/PcbCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { LAYOUTS } from '../data/labels.js';

const pcbEntries = await getCollection('pcbs');
const pcbs = pcbEntries.map((e) => ({ ...e.data, slug: e.data.slug || e.id }));
const total = pcbs.length;

const counts = Object.fromEntries(LAYOUTS.map((l) => [l, pcbs.filter((p) => p.layout === l).length]));
const featured = pcbs.filter((p) => p.featured).slice(0, 6);

const guideHref = '/guides/flashing-firmware-qmk-toolbox';

// Editable home-page text (CMS → Site pages → Home page), with fallbacks.
const home = (await getEntry('site', 'home'))?.data ?? {};
const eyebrow = home.eyebrow || "Mechlovin' Studio · PCB resource hub";
const headline = home.headline || 'Specs, layouts, and firmware for every Mechlovin PCB.';
const lede = home.lede || 'One place for everything you need to build and maintain your keyboard — full specifications, supported layouts, firmware and VIA downloads, compatibility notes, and step-by-step guides.';
const searchPlaceholder = (home.searchPlaceholder || 'Search {count} PCBs by name or layout…').replace('{count}', String(total));
const pathwaysTitle = home.pathwaysTitle || 'Start here';
const featuredTitle = home.featuredTitle || 'Featured PCBs';
const guidesTitle = home.guidesTitle || 'Build guides';

// The three pathway cards: links + icons + meta are fixed; title/description are editable.
const p = home.pathways ?? [];
const pathways = [
  { href: '/pcbs', meta: `${total} PCBs · ${LAYOUTS.length} layouts`, title: p[0]?.title || 'Browse PCBs', description: p[0]?.description || 'Every board, filterable by layout. Specs, supported layouts, and downloads on each page.' },
  { href: '/compatibility', meta: 'Case · plate · switch · mount', title: p[1]?.title || 'Compatibility check', description: p[1]?.description || 'Filter boards by switch type, mount style, and features to find what fits your build.' },
  { href: guideHref, meta: 'Firmware · VIA · QMK', title: p[2]?.title || 'Build guides', description: p[2]?.description || 'Step-by-step instructions for flashing firmware, setting up VIA, and troubleshooting.' },
];
const pathwayIcons = [
  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h.01M11 9h.01M15 9h.01M7 13h10"/>',
  '<path d="M20 6 9 17l-5-5"/>',
  '<path d="M13 2 3 14h9l-1 8 10-12h-9z"/>',
];

// Build-guides list is pulled from the guides collection (newest order first).
const guideEntries = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const guides = guideEntries.slice(0, 3).map((g, i) => ({
  idx: String(i + 1).padStart(2, '0'),
  title: g.data.title,
  desc: (g.data.lede || '').replace(/<[^>]+>/g, ''),
  tag: g.data.tag,
  href: `/guides/${g.data.slug || g.id}`,
}));
---
<Base title="Mechlovin Studio — PCB Resource Hub">
  <header class="home-hero">
    <div class="eyebrow">{eyebrow}</div>
    <h1>{headline}</h1>
    <p class="lede">{lede}</p>
    <form class="home-search" id="home-search" action="/pcbs" method="get">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input name="q" placeholder={searchPlaceholder} />
      <span class="kbd">⏎</span>
    </form>
    <div class="home-layout-chips">
      <span class="label">Jump to a layout</span>
      {LAYOUTS.map((l) => (
        <a class="layout-chip" href={`/pcbs#${encodeURIComponent(l)}`}>
          {l} <span class="cnt">{counts[l]}</span>
        </a>
      ))}
    </div>
  </header>

  <section class="home-section">
    <div class="home-section-head"><h2>{pathwaysTitle}</h2></div>
    <div class="pathways">
      {pathways.map((pw, i) => (
        <a class="pathway" href={pw.href}>
          <div class="pathway-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={pathwayIcons[i]} />
          </div>
          <h3>{pw.title} <span class="pathway-arrow">→</span></h3>
          <p>{pw.description}</p>
          <div class="pathway-meta">{pw.meta}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2>{featuredTitle}</h2>
      <a class="view-all" href="/pcbs">View all {total} →</a>
    </div>
    <div class="pcb-grid">
      {featured.map((p) => <PcbCard pcb={p} />)}
    </div>
  </section>

  {guides.length > 0 && (
    <section class="home-section">
      <div class="home-section-head">
        <h2>{guidesTitle}</h2>
        <a class="view-all" href="/guides">All guides →</a>
      </div>
      <div class="guides-list">
        {guides.map((g) => (
          <a class="guide-row" href={g.href}>
            <span class="idx">{g.idx}</span>
            <span class="guide-info">
              <span class="title">{g.title}</span>
              <span class="desc">{g.desc}</span>
            </span>
            {g.tag && <span class="guide-tag">{g.tag}</span>}
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  // Hero search navigates to the PCBs listing (matching the prototype).
  const form = document.getElementById('home-search');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    window.location.href = '/pcbs';
  });
</script>
