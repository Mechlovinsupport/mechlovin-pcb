---
import Base from '../../layouts/Base.astro';
import Specs from '../../components/Specs.astro';
import Layouts from '../../components/Layouts.astro';
import Downloads from '../../components/Downloads.astro';
import Compatibility from '../../components/Compatibility.astro';
import Changelog from '../../components/Changelog.astro';
import Vendors from '../../components/Vendors.astro';
import { getCollection } from 'astro:content';
import { SWITCH_LABELS } from '../../data/labels.js';

export async function getStaticPaths() {
  const pcbs = await getCollection('pcbs');
  return pcbs.map((entry) => {
    const slug = entry.data.slug || entry.id;
    return {
      params: { slug },
      props: { pcb: { ...entry.data, slug } },
    };
  });
}

const { pcb } = Astro.props;

const gallery = [pcb.heroImage, ...(pcb.images ?? [])].filter(Boolean);

const TYPE_LABELS = { stock: 'Stock', commission: 'Commission' };
const typeLabel = TYPE_LABELS[pcb.type] || '';

const switchTypes = pcb.switches.map((s) => SWITCH_LABELS[s] || s);
const switchLabel = switchTypes.join(' · ');
const hasSwitchInfo = switchTypes.length > 0;

const dash = (v) => (v && String(v).trim() ? v : '—');
const stats = [
  { label: 'Layout', val: dash(pcb.layout) },
  { label: 'Switch', val: hasSwitchInfo ? switchLabel : '—' },
  { label: 'Revision', val: dash(pcb.rev.replace(/^Rev\.\s*/, '')) },
  { label: 'Released', val: dash(pcb.released) },
];
const sectionNav = [
  { id: 'specs', label: 'Specs' },
  { id: 'layouts', label: 'Layouts' },
  { id: 'downloads', label: 'Downloads' },
  { id: 'compatibility', label: 'Compatibility' },
  { id: 'changelog', label: 'Changelog' },
  { id: 'where-to-buy', label: 'Where to buy' },
];
const updated = pcb.changelog?.[0]?.date || pcb.released;
const guideHref = '/guides/flashing-firmware-qmk-toolbox';
const configuratorUrl = 'https://mechlovin.studio';
---
<Base title={`${pcb.name} — Mechlovin Studio`} description={pcb.lede} active="pcbs">
  <header class="pagehead">
    <div>
      <div class="breadcrumb">
        <a href="/pcbs">All PCBs</a>
        <span class="sep">/</span>
        {pcb.layout && (<><a href={`/pcbs#${encodeURIComponent(pcb.layout)}`}>{pcb.layout}</a><span class="sep">/</span></>)}
        <span style="color: var(--ink-2)">{pcb.name}</span>
      </div>
      <h1>{pcb.name}</h1>
      {pcb.subtitle && <div class="subtitle">{pcb.subtitle}</div>}
      {typeLabel && (
        <div class="tag-row">
          <span class="tag accent">{typeLabel}</span>
        </div>
      )}
      {pcb.lede && <p class="lede">{pcb.lede}</p>}
      <div class="head-stats">
        {stats.map((s) => (
          <div>
            <div class="label">{s.label}</div>
            <div class="val">{s.val}</div>
          </div>
        ))}
      </div>
      <div class="head-cta">
        <a class="btn btn-primary" href={configuratorUrl} target="_blank" rel="noopener">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z M4 10h16 M10 4v16"/></svg>
          Open in Mechlovin' PCB Configurator
        </a>
        <a class="btn btn-ghost" href={guideHref}>Build guide</a>
      </div>
    </div>
    <div>
      <div class="head-image" id="hero-image">
        {gallery.length
          ? <img id="hero-img" src={gallery[0]} alt={pcb.name} />
          : <div class="placeholder"><span>Add photos in the editor</span></div>}
      </div>
      {gallery.length > 1 && (
        <div class="head-thumbs">
          {gallery.map((src, i) => (
            <div
              class={i === 0 ? 'active' : ''}
              data-src={src}
              style={`background-image:url('${src}');background-size:cover;background-position:center;`}
            ></div>
          ))}
        </div>
      )}
    </div>
  </header>

  <nav class="section-nav">
    <div class="section-nav-inner">
      {sectionNav.map((it, i) => (
        <a href={`#${it.id}`} class={i === 0 ? 'active' : ''} data-spy={it.id}>{it.label}</a>
      ))}
      <div class="section-nav-right">
        <span>Updated {updated}</span>
      </div>
    </div>
  </nav>

  <Specs specs={pcb.specs} />
  <Layouts layoutSvg={pcb.layoutSvg} name={pcb.name} />
  <Downloads downloads={pcb.downloads} />
  <Compatibility compatibility={pcb.compatibility} name={pcb.name} />
  <Changelog changelog={pcb.changelog} />
  <Vendors vendors={pcb.vendors} />

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <img id="lightbox-img" src="" alt="" />
  </div>
</Base>

<style>
  .head-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .head-image.zoomable { cursor: zoom-in; }
  .head-thumbs > div { cursor: pointer; }
  .lightbox {
    position: fixed; inset: 0;
    background: oklch(0% 0 0 / 0.82);
    display: none; align-items: center; justify-content: center;
    padding: 40px; z-index: 200; cursor: zoom-out;
  }
  .lightbox.open { display: flex; }
  .lightbox img {
    max-width: 100%; max-height: 100%;
    border-radius: var(--radius);
    box-shadow: 0 12px 48px oklch(0% 0 0 / 0.5);
  }
</style>

<script>
  // Gallery: clicking a thumbnail swaps the main photo; clicking the main photo
  // opens a simple full-screen lightbox (click anywhere or press Esc to close).
  const heroWrap = document.getElementById('hero-image');
  const heroImg = document.getElementById('hero-img');
  const thumbEls = Array.from(document.querySelectorAll('.head-thumbs > div'));
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');

  thumbEls.forEach((el) => {
    el.addEventListener('click', () => {
      thumbEls.forEach((t) => t.classList.remove('active'));
      el.classList.add('active');
      const src = el.getAttribute('data-src');
      if (heroImg && src) heroImg.setAttribute('src', src);
    });
  });

  function openLightbox(src) {
    if (!lightbox || !lightboxImg || !src) return;
    lightboxImg.setAttribute('src', src);
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  if (heroImg && heroWrap) {
    heroWrap.classList.add('zoomable');
    heroImg.addEventListener('click', () => openLightbox(heroImg.getAttribute('src')));
  }
  if (lightbox) lightbox.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

  // Sticky section-nav scroll-spy.
  const spyLinks = Array.from(document.querySelectorAll('.section-nav a[data-spy]'));
  const ids = spyLinks.map((a) => a.getAttribute('data-spy'));
  function onScroll() {
    const y = window.scrollY + 150;
    let idx = 0;
    ids.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= y) idx = i;
    });
    spyLinks.forEach((a, i) => a.classList.toggle('active', i === idx));
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
